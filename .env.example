# PatentMind environment template.
# Copy to `.env` and adjust. Vars marked [PROD] MUST be overridden in production.
# Every variable corresponds to one in backend/shared/config.py:Settings.

# ---------------------------------------------------------------------------
# Service ports / URLs
# ---------------------------------------------------------------------------
GATEWAY_PORT=8010
AI_ENGINE_PORT=8011
GATEWAY_URL=http://localhost:8010
AI_ENGINE_URL=http://localhost:8011

# ---------------------------------------------------------------------------
# Auth (Q12)
# ---------------------------------------------------------------------------
# [PROD/DEMO] MUST be a random 32+ byte secret. Generate: openssl rand -hex 32
# Backend now refuses to boot in ANY mode (mock included) with this placeholder.
# `scripts/start_demo.sh` auto-generates one on first run if .env is empty.
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
# [H-5] Issuer / audience pinned on every session token (confused-deputy guard).
JWT_ISS=patentmind-gateway
JWT_AUD=patentmind-api
# [H-5 phase 3] Algorithm. Default HS256 (symmetric, uses JWT_SECRET above).
# For asymmetric signing set JWT_ALGO=RS256 and supply a PEM key PAIR below —
# the gateway signs with the private key; verifiers hold only the public key
# (a public-key holder cannot mint tokens). Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_priv.pem
#   openssl rsa -in jwt_priv.pem -pubout -out jwt_pub.pem
JWT_ALGO=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# OIDC IdP (Q12)  stub | keycloak
# ---------------------------------------------------------------------------
# stub (default): offline HMAC stub IdP — demo + test suite need no docker.
# keycloak: REAL Keycloak. /v1/auth/oidc/begin redirects to the realm's
# authorize endpoint (auto-discovery), /v1/auth/oidc/callback exchanges the
# code, verifies the ID token against the realm JWKS (RS256), maps client
# roles + the tenant_id claim to our four roles, then issues OUR OWN gateway
# session JWT. Bring the IdP up with:  docker compose up -d keycloak
# (realm `patentmind` auto-imports from keycloak/realm-patentmind.json:
#  client patentmind-gateway + users alice/bob/carol/audit_dave, passwords
#  demo-<user>). Smoke: bash scripts/smoke_keycloak.sh
OIDC_MODE=stub
OIDC_KEYCLOAK_ISSUER=http://localhost:8081/realms/patentmind
OIDC_KEYCLOAK_CLIENT_ID=patentmind-gateway
# [PROD] REQUIRED when OIDC_MODE=keycloak (boot refuses an empty secret
# outside mock/test). Dev realm import ships:
#   patentmind-gateway-dev-secret-change-me   — rotate it for anything real.
OIDC_KEYCLOAK_CLIENT_SECRET=
# Must byte-match a redirect URI registered on the client (authorize + token
# exchange legs both send it).
OIDC_REDIRECT_URI=http://localhost:5173/auth/oidc/callback
# Claim names for role/tenant mapping (see backend/gateway/oidc_keycloak.py:
# flat role claim > resource_access.<client>.roles > realm_access.roles).
OIDC_ROLE_CLAIM=role
OIDC_TENANT_CLAIM=tenant_id
# Keycloak container knobs (docker-compose.yml). 8081 because 8010/8011/8088/
# 18080/6333/6379/15432/5432 are taken on the delivery box.
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin

# ---------------------------------------------------------------------------
# Demo-mode click-through login (Security Chunk A — C-1)
# ---------------------------------------------------------------------------
# When set, /v1/auth/login accepts the `X-Demo-Secret` header instead of a
# password for any known user. Frictionless for stakeholder demos — the SPA's
# Login.jsx "click Alice" buttons send this header so attendees don't type.
# Leave UNSET in production. POC demo passwords are `demo-{user_id}` (e.g.
# `demo-alice`, `demo-bob`, `demo-carol`, `demo-audit_dave`).
# Example: openssl rand -hex 16
DEMO_LOGIN_SECRET=

# ---------------------------------------------------------------------------
# AI Engine internal token (Security Chunk A — C-2)
# ---------------------------------------------------------------------------
# Gateway injects this on every outbound httpx call to :8011. AI Engine
# refuses any request lacking it (except /v1/health). Closes the "anyone on
# the network can poison the RAG / burn the Anthropic budget" gap.
#
# Rules:
#   - Set + non-mock mode: required on every non-health request.
#   - Empty + LLM_MODE=mock: PERMITTED (pytest in-process ASGITransport case).
#   - Empty + non-mock:  AI Engine refuses everything but /v1/health.
# Example: openssl rand -hex 32
INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# CORS allow-list (Security Chunk C — H-1)
# ---------------------------------------------------------------------------
# Comma-separated list of origins permitted to call the gateway from a
# browser. Default is the vite dev SPA on :5173. Production MUST replace
# this with the actual SPA origin (e.g. "https://patentmind.example.com").
# NEVER use "*" — that disables CORS protection entirely. Pair with
# specific allow_methods + allow_headers (set in backend/gateway/main.py).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Max request body bytes (Security Chunk C — H-2)
# ---------------------------------------------------------------------------
# Hard cap on inbound request bodies, enforced by middleware via the
# Content-Length header BEFORE Pydantic parse. Bodies above this size get
# a 413 with no memory cost. Default 100MB is generous enough for 30MB PDF
# uploads while bounding worst-case memory.
MAX_BODY_BYTES=104857600

# ---------------------------------------------------------------------------
# uvicorn bind host (Security Chunk C — M-9)
# ---------------------------------------------------------------------------
# Host that uvicorn binds to when running via `python -m backend.gateway.main`
# or `python -m backend.ai_engine.main`. Default 127.0.0.1 keeps the
# services loopback-only — production should run behind a reverse proxy
# (digiRunner / nginx) on the actual public port. Set to 0.0.0.0 ONLY
# when this process is intentionally the public edge (container or VM
# with no proxy in front).
LISTEN_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Upstream auth trust (Compat Refactor 3 — digiRunner migration prep)
# ---------------------------------------------------------------------------
# Comma-separated IPs that may set x-user-id / x-tenant-id / x-user-role
# headers (= digiRunner-validated identity). Anyone NOT from these IPs falls
# back to JWT auth. Default covers local dev + docker bridge network.
# WARNING: never widen to 0.0.0.0 / wildcards — that disables the spoofing
# guard entirely. Add the digiRunner pod IP / docker bridge gateway only.
# Plain IPs ONLY — CIDR notation (10.0.0.0/24) is rejected at boot.
TRUSTED_UPSTREAM_IPS=127.0.0.1,::1
# digiRunner in docker: add the bridge gateway AND set UPSTREAM_AUTH_SHARED_SECRET
# TRUSTED_UPSTREAM_IPS=127.0.0.1,::1,172.17.0.1

# Defence-in-depth shared secret for upstream-trust auth. When set, requests
# claiming upstream identity MUST also carry a matching `x-upstream-auth-token`
# header or the upstream-trust path declines (= falls back to JWT).
# [PROD] REQUIRED when TRUSTED_UPSTREAM_IPS contains any non-loopback entry
# in non-mock mode. The backend refuses to boot if this guard is violated.
# generate: openssl rand -hex 32
UPSTREAM_AUTH_SHARED_SECRET=

# Master key for the on-prem reversible PII mapping table (Q3/Q10) and the
# keyed placeholder ids. If unset it is DERIVED FROM JWT_SECRET (dev only):
# rotating JWT_SECRET or restoring onto a host with a different JWT_SECRET then
# makes every stored mapping undecryptable. Set it explicitly and back it up
# with the DR material (ops/DR_RUNBOOK.md).
# generate: openssl rand -hex 32
MAPPING_ENCRYPTION_KEY=

# Q25 NER masking layered on the regex PII rules + tenant dictionary:
#   none | rules (default; role-anchored names, company suffixes, addresses)
#   | ckip (ckip-transformers UNIONED with rules; falls back to rules)
NER_BACKEND=rules
# ckip model: bert-base | albert-base | albert-tiny
NER_CKIP_MODEL=albert-tiny
# -1 = CPU, 0 = first CUDA GPU
NER_CKIP_DEVICE=-1

# ---------------------------------------------------------------------------
# Security phase 2 (2026-09-25)
# ---------------------------------------------------------------------------
# Q26 audit hash chain: HMAC-SHA256 key over every persisted audit field.
# REQUIRED outside LLM_MODE=mock (boot refuses without it). Back it up with the
# DR material — verifying existing rows needs the same key.
# generate: openssl rand -hex 32
AUDIT_HMAC_KEY=
# Q21 key rotation (Ops phase 2026-09-26). Keyring form "kid:secret,kid:secret";
# new rows are signed with AUDIT_HMAC_ACTIVE_KID and record the kid per row.
# A lone AUDIT_HMAC_KEY above is kid "k1". To rotate: keep the old key in the
# ring (rows it signed stay verifiable), add a new kid, switch the active kid.
# A kid missing from the ring makes its rows UNVERIFIABLE (reported, not passed).
# e.g. AUDIT_HMAC_KEYS=k1:<old>,k2:<new>   AUDIT_HMAC_ACTIVE_KID=k2
AUDIT_HMAC_KEYS=
AUDIT_HMAC_ACTIVE_KID=

# Q22 server-side case registry (security_level per case_id). Unregistered
# cases are CONFIDENTIAL (local LLM only, upload blocked). Default path:
# data/case_registry.json
CASE_REGISTRY_PATH=

# Q24 built-in demo passwords `demo-{user_id}`. Unset = enabled only in
# LLM_MODE=mock. Set false to disable everywhere; true to force-enable (never
# in production).
DEMO_PASSWORDS_ENABLED=

# Q23 magic-link email delivery (stdlib SMTP). Empty SMTP_HOST = no mail sent.
# SMTP_SECURITY: starttls (587) | ssl (465) | none (local relay only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SEC=10
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# The emailed link is <MAGIC_LINK_BASE_URL>#token=<token>
MAGIC_LINK_BASE_URL=http://localhost:5173/login
# DEMO-ONLY: also return the token in the HTTP response (default: mock mode)
MAGIC_LINK_RETURN_TOKEN=

# Q30 Prometheus scrape token for /metrics (gateway + ai_engine). Unset =
# /metrics answers loopback clients only.
# generate: openssl rand -hex 32
METRICS_TOKEN=

# Ops phase (2026-09-26) — docker compose app/monitoring profiles (ops/README.md)
# Host port of the SPA container (the one LAN-facing port).
FRONTEND_PORT=8080
# ai_engine image: true = CPU torch + sentence-transformers (bge-m3/qwen3/
# reranker); false = slim image for EMBEDDING_BACKEND=mock|lexical.
AI_ENGINE_INSTALL_ML=true
# Grafana admin (monitoring profile refuses to start without a password).
GRAFANA_ADMIN_USER=admin
# generate: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=

# Q29 ngrok tunnel HTTP basic auth (user:password). Generated by
# scripts/start_ngrok.sh on first run if absent.
NGROK_BASIC_AUTH=

# ---------------------------------------------------------------------------
# LLM router (Q15)  mock | openai | anthropic | local | dify
# ---------------------------------------------------------------------------
# Delivery default (2026-09-25, Q13): local = Ollama direct (qwen2.5:7b, no
# cloud key, nothing leaves the box). Use mock for an offline demo without
# Ollama; the test suite forces mock itself (tests/conftest.py).
LLM_MODE=local
LLM_MODEL_REASONING=claude-sonnet-mock
LLM_MODEL_CHEAP=haiku-mock
LLM_MODEL_LOCAL=qwen2.5:7b
LLM_MODEL_VERIFIER=haiku-mock
# Q15/Q16/Q18 claim-element table: how claims are split into elements.
# auto = the model when LLM_MODE is local|anthropic (accepted only if every
# element is copied verbatim from the claim), otherwise rules; rules | llm.
CLAIM_ELEMENTS_DECOMPOSER=auto
# Turn the element-table step off entirely (true | false).
CLAIM_ELEMENTS_ENABLED=true
# [PROD] required when LLM_MODE in (openai, anthropic)
LLM_API_KEY=
# [PROD] required when LLM_MODE=anthropic (in addition to LLM_API_KEY)
ANTHROPIC_API_KEY=

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Per-call budget; the gateway waits this + 30 s, the SPA 420 s in total.
OLLAMA_TIMEOUT_SEC=300
# Start-up warm-up keeps the local model loaded this long (also set it on the
# Ollama server itself: OLLAMA_KEEP_ALIVE=30m).
OLLAMA_KEEP_ALIVE=30m
# Whole-analysis budget: one deadline per analysis; the AI Engine gets the
# seconds left (X-Time-Budget). Keep it below the SPA's 420 s.
ANALYZE_DEADLINE_SEC=390
# Local-mode citation verifier. Empty = deterministic verifier (same as Dify
# mode). Set to a DIFFERENT local model for an independent LLM second opinion.
LOCAL_VERIFIER_MODEL=
# Ollama server side (set where `ollama serve` runs, not here): let the
# per-rejection drafts actually run in parallel and keep the model loaded.
#   OLLAMA_NUM_PARALLEL=4      (qwen2.5-7B: ~0.9 GB KV for 4 x 4096 tokens)
#   OLLAMA_KEEP_ALIVE=24h      (no cold load on the first request after idle)

# ---------------------------------------------------------------------------
# Dify CE (Phase 3 — LLM_MODE=dify). Self-hosted at <PATENTMIND_INFRA_DIR>\dify
# (docker compose, nginx on :8088). parse_oa + draft_response run through the
# `patentmind-analyze-oa` workflow app (LLM nodes on local Ollama qwen2.5:7b);
# the Q14 citation verifier STAYS in our code (deterministic hard wall).
# Bootstrap everything with: python scripts/setup_dify.py  (see scripts/setup_dify.md)
# ---------------------------------------------------------------------------
DIFY_API_URL=http://localhost:8088
# Service API key of the analyze workflow app ("app-..."), written by setup_dify.py
DIFY_API_KEY_ANALYZE=
# Generous: qwen2.5:7b can take 60-120s+ per long zh-TW generation
DIFY_TIMEOUT_SEC=300
DIFY_MODEL_LABEL=dify/qwen2.5:7b
# Dify console admin credentials (created by setup_dify.py on first run)
DIFY_ADMIN_EMAIL=
DIFY_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Cache (Q9)  memory | redis
# ---------------------------------------------------------------------------
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Connect/read timeout for the cache + rate-limit clients (seconds). A hung
# Redis then reads as a cache miss / hits RATE_LIMIT_REDIS_DEGRADE quickly.
REDIS_SOCKET_TIMEOUT_SEC=0.5
# Part of every analysis cache key: bump after changing prompts or the corpus.
# (Cached analyses are encrypted at rest with a per-tenant key and never cached
# when degraded.)
ANALYSIS_CACHE_VERSION=2
# [H-5] session-token revocation store (logout kill switch). memory | redis.
# `redis` (reuses REDIS_URL) makes logout durable across restart + replicas.
REVOCATION_BACKEND=memory
# Store unreachable → requests fail closed with 503 + this Retry-After (seconds).
REVOCATION_RETRY_AFTER_SEC=5

# [Q18 / M-12] cost circuit breaker (daily USD; tripped = degrade to the cheap
# model). Each tenant trips on its own spend; the fleet-wide value is only a
# backstop — keep it above the sum of normal tenant spend.
COST_CIRCUIT_TENANT_DAILY_USD=100
COST_CIRCUIT_DAILY_USD=1000

# ---------------------------------------------------------------------------
# Deadline holiday calendars (Q17/Q20)
# ---------------------------------------------------------------------------
# auto = pick data/calendars/<J>_<YYYY>.<rev>.json per year the deadline touches
# (highest rev). Set an explicit version (e.g. 2025.1) only to replay/pin.
HOLIDAY_CALENDAR_VERSION=auto

# ---------------------------------------------------------------------------
# Vector store (Q7)  memory | qdrant
# ---------------------------------------------------------------------------
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Embedding (Q5/Q7/Q9)  mock | bge-m3 | qwen3
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=mock
EMBEDDING_MODEL=BAAI/bge-m3
# Q9 A/B: EMBEDDING_BACKEND=qwen3 loads this model (lazy, optional dep).
QWEN3_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# auto | cpu | cuda  (auto uses the GPU only when enough VRAM is FREE)
EMBEDDING_DEVICE=auto
# dense | hybrid  (dense + sparse fused via RRF)
RETRIEVAL_MODE=dense
# Q10 reranker over the fused candidates: none | qwen3-4b
RERANKER_BACKEND=none
RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
# auto | cpu | cuda
RERANKER_DEVICE=auto
# candidates passed to the reranker before cutting to top_k
RERANK_CANDIDATES=50
# Q13 contextual retrieval: off | template (deterministic) | llm (cached;
# confidential content stays on the local model)
CONTEXTUAL_RETRIEVAL=template
# empty = data/rag_context_cache
CONTEXT_CACHE_DIR=
# Data-loss guard (Q7): when an existing Qdrant collection's stored vector dim
# mismatches the current embedder (mock 384 <-> bge-m3 1024), the store REFUSES
# to drop it. Set true ONLY for a deliberate operator-driven re-index.
QDRANT_ALLOW_REINDEX=false
#
# HOW TO SWITCH TO REAL RAG (real recall@5 numbers, not mock SHA-256 noise):
#   1. bash scripts/start_rag_stack.sh     # boots Qdrant (docker-compose.rag.yml), waits /readyz
#   2. pip install 'sentence-transformers>=2.7' torch
#      python scripts/prefetch_bge_m3.py   # one-time multi-GB model cache, prints dim 1024
#   3. export VECTOR_BACKEND=qdrant EMBEDDING_BACKEND=bge-m3
#   4. python scripts/rag_smoke.py         # indexes seed patents → prints REAL recall@5 / MRR

# ---------------------------------------------------------------------------
# Storage (Q13 audit archive / Q20 backups)  AUDIT_BACKEND: sqlite | postgres
# ---------------------------------------------------------------------------
# sqlite (default, zero infra) | postgres (compose container; same append-only
# triggers + hash chain, enforced by plpgsql). With postgres the gateway
# REFUSES to boot if the DB is unreachable (invariant #4 — no audit, no service).
AUDIT_BACKEND=sqlite
# [PROD] override password and host. Used by AUDIT_BACKEND=postgres.
# NB: the compose container binds HOST PORT 15432 on the delivery box (5432 is
# taken by a foreign Postgres) — use :15432 when enabling the postgres backend:
#   POSTGRES_URL=postgresql://patentmind:patentmind@localhost:15432/patentmind
POSTGRES_URL=postgresql://patentmind:patentmind@localhost:15432/patentmind

# Optional: used by docker-compose.yml when starting the local Postgres container.
POSTGRES_DB=patentmind
POSTGRES_USER=patentmind
POSTGRES_PASSWORD=patentmind

# ---------------------------------------------------------------------------
# Q13 WORM archive target (audit_archive.py)  ARCHIVE_BACKEND: local | s3
# ---------------------------------------------------------------------------
# local (default) — sealed segments under data/audit_archive/, files flipped
#                   read-only (Object Lock simulation; zero infra).
# s3              — real S3 Object Lock bucket. Delivery stack uses the
#                   compose RustFS (S3 API :19000, console :19001). One-shot
#                   bucket init (Object Lock can ONLY be enabled at creation):
#                       docker compose up -d rustfs
#                       python scripts/init_object_store.py
ARCHIVE_BACKEND=local
ARCHIVE_S3_ENDPOINT=http://localhost:19000
ARCHIVE_S3_ACCESS_KEY=patentmind
ARCHIVE_S3_SECRET_KEY=patentmind-worm
ARCHIVE_S3_BUCKET=patentmind-audit-worm
ARCHIVE_S3_REGION=us-east-1
# Object Lock retention stamped on every sealed segment/manifest object.
# GOVERNANCE: deletable only with s3:BypassGovernanceRetention (dev-friendly).
# COMPLIANCE: NOBODY can delete until expiry — [PROD] posture for Q13's 7 years.
ARCHIVE_S3_RETENTION_MODE=GOVERNANCE
ARCHIVE_S3_RETENTION_DAYS=2555

# RustFS container credentials (docker-compose.yml; console at :19001).
# Defaults match ARCHIVE_S3_ACCESS_KEY/SECRET_KEY above — keep them in sync.
RUSTFS_ACCESS_KEY=patentmind
RUSTFS_SECRET_KEY=patentmind-worm

# ---------------------------------------------------------------------------
# PDF upload (Day 2)
# ---------------------------------------------------------------------------
# Max upload size in megabytes — gateway rejects larger bodies with 413.
MAX_UPLOAD_MB=30
# A PDF page producing fewer than this many extracted-text chars is treated as
# a scanned page and routed through Claude Vision OCR.
MIN_CHARS_PER_PAGE_FOR_TEXT=30
# Max concurrent Vision OCR calls per upload. Cap protects rate limits + cost.
OCR_PARALLELISM=4
# OCR engine for scanned pages (Q14): mock (tests/demo) | paddleocr-vl (on-prem
# primary; GPU if available, falls back to tesseract when paddleocr is not
# installed) | tesseract (on-prem) | vision (cloud Claude Vision, public cases
# only). Confidential scans are refused unless this is paddleocr-vl/tesseract.
OCR_BACKEND=mock
# PaddleOCR-VL device: auto | cpu | gpu | gpu:N  (8 GB RTX 3060 is enough)
OCR_PADDLE_DEVICE=auto

# ---------------------------------------------------------------------------
# AI Engine prompt introspection (Compat Refactor 1)
# ---------------------------------------------------------------------------
# Controls GET /v1/prompts and GET /v1/prompts/{intent} on the AI Engine.
# These endpoints expose our externalized system-prompts (used by Dify import
# + dev sanity checks). AI Engine has no per-endpoint auth — it's intra-VPC
# only — so prod operators who don't want the prompts reachable even from
# inside the VPC should set this to false. The endpoints then return 404.
# [PROD] consider setting to "false" once Dify import is complete.
EXPOSE_PROMPT_API=true

# ---------------------------------------------------------------------------
# Observability (Day 5 — Sentry; no-op when DSN is unset)
# ---------------------------------------------------------------------------
# Backend (gateway + ai_engine) — both services tag events with `service`.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
# Frontend (vite-exposed; MUST be VITE_ prefix). Use a SEPARATE Sentry project
# from the backend so attendee browsers can't write to the backend project key.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=dev
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Legacy OCR/RAG CLI (ocr_rag_cli/) — kept for backward compatibility.
# Safe to ignore unless you actually run the OCR prototype.
# ---------------------------------------------------------------------------
QDRANT_COLLECTION=ocr_rag_documents
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
TOP_K=5

# ---------------------------------------------------------------------------
# Local infra port remaps (delivery box) + test deps
# ---------------------------------------------------------------------------
# Host port for the docker-compose Postgres. Default 15432 because host 5432
# is occupied by a foreign Postgres container (pulse-db) on the delivery box.
# When AUDIT_BACKEND=postgres, point POSTGRES_URL at this port, e.g.
#   POSTGRES_URL=postgresql://patentmind:patentmind@localhost:15432/patentmind
POSTGRES_HOST_PORT=15432

# ---------------------------------------------------------------------------
# digiRunner Open Source — front-line API gateway (TPIsoftware dgrv4)
# Deployed OUTSIDE the repo at <PATENTMIND_INFRA_DIR>\digirunner (docker compose).
# Start: bash scripts/start_digirunner.sh   Smoke: bash scripts/smoke_digirunner.sh
# Docs:  scripts/setup_digirunner.md
# ---------------------------------------------------------------------------
# digiRunner base URL (admin console at ${DGR_URL}/dgrv4/login,
# proxied PatentMind routes at ${DGR_URL}/dgrc/v1/*).
DGR_URL=http://localhost:18080
# Admin console credentials. manager/manager123 is the OSS image default —
# CHANGE THE PASSWORD before any non-local deployment.
DGR_ADMIN_USER=manager
DGR_ADMIN_PASS=manager123
# Upstream-trust auth (Day 8C contract, backend/gateway/auth.py):
# Docker Desktop delivers digiRunner->host traffic from 127.0.0.1, so the
# loopback trust list covers the digiRunner hop. The shared secret gates the
# x-user-id / x-tenant-id / x-user-role identity headers (defence in depth —
# without it any local process could assert an identity).
TRUSTED_UPSTREAM_IPS=127.0.0.1,::1
# UPSTREAM_AUTH_SHARED_SECRET — set once in the upstream-trust section above.
# Frontend through digiRunner (see frontend/vite.config.js):
#   VITE_API_TARGET=http://localhost:18080 VITE_API_PATH_PREFIX=dgrc npm run dev
# (prefix WITHOUT leading slash — Git Bash mangles leading-slash args)
